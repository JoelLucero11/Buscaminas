<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Buscaminas.ViewModels"
                    xmlns:viewPage="clr-namespace:Buscaminas.Views">

    <DataTemplate DataType="{x:Type vm:WelcomeVM}">
        <viewPage:Welcome/>
    </DataTemplate>
                  
    <DataTemplate DataType="{x:Type vm:MainMenuVM}">
        <viewPage:MainMenu/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:GameVM}">
        <viewPage:Game/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SettingsVM}">
        <viewPage:Settings/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DifficultySelectionVM}">
        <viewPage:DifficultySelection/>
    </DataTemplate>

</ResourceDictionary>