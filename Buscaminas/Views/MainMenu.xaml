<UserControl x:Class="Buscaminas.Views.MainMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Buscaminas.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center">

            <TextBlock Text="BUSCAMINAS"
                       FontSize="62"
                       FontWeight="Black"
                       FontFamily="Segoe UI Black"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4">
            </TextBlock>

            <TextBlock Text="— ¡Cuidado! Es terreno minado —"
                       FontSize="12"
                       FontStyle="Italic"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,35"/>

            <Button Content="▶  Jugar"
                    Command="{Binding GameCommand}"
                    Margin="0,0,0,14"/>

            <Button Content="⚙  Opciones"
                    Command="{Binding SettingsCommand}"
                    Margin="0,0,0,14"/>

            <Button Content="✕  Salir"
                    Command="{Binding ExitCommand}"/>

        </StackPanel>

        <Button Grid.Row="2"
                Style="{StaticResource HowToPlayButton}"
                Content="?"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"/>
    </Grid>
</UserControl>
