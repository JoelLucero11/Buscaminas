<UserControl x:Class="Buscaminas.Views.Game"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Buscaminas.Views" 
             xmlns:viewmodels="clr-namespace:Buscaminas.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel HorizontalAlignment="Left" Grid.Column="0">
            <TextBlock Text="Buscaminas" HorizontalAlignment="Center"/>
            <Button Content="Nuevo Juego" Width="150" Height="40"
                    Command="{Binding StartNewGame}"/>
            <Button Content="Cargar Juego" Width="150" Height="40"/>
            <Button Content="Configuración" Width="150" Height="40"/>
        </StackPanel>

        <StackPanel Grid.Column="1" >
            <TextBlock Text="{Binding ElapsedTime}" FontSize="40" HorizontalAlignment="Center"/>
            <ItemsControl ItemsSource="{Binding Cells}" Height="400" Width="400" HorizontalAlignment="Center">
            
            <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                         <UniformGrid Columns="{Binding Column}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CellButton}">

                            <Button.InputBindings>
                                <MouseBinding Gesture="RightClick"
                                              Command="{Binding RightClickCommand}"/>
                                <MouseBinding Gesture="LeftClick"
                                              Command="{Binding IsRevealed}"/>
                            </Button.InputBindings>

                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </StackPanel>

    </Grid>
</UserControl>
