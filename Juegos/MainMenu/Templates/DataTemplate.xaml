<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:MainMenu.ViewModels"
                    xmlns:viewPage="clr-namespace:MainMenu.Views">


    <DataTemplate DataType="{x:Type vm:WelcomeVM}">
        <viewPage:Welcome/>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vm:MainMenuVM}">
        <viewPage:MainMenu/>    
    </DataTemplate>

</ResourceDictionary>