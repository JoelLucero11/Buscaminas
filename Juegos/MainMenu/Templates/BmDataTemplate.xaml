<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Buscaminas.ViewModels;assembly=Buscaminas"
                    xmlns:viewPage="clr-namespace:Buscaminas.Views;assembly=Buscaminas">

                  
    <DataTemplate DataType="{x:Type vm:MainMenuVM}">
        <viewPage:MainMenu/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:GameVM}">
        <viewPage:Game/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DifficultySelectionVM}">
        <viewPage:DifficultySelection/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HowToPlayVM}">
        <viewPage:HowToPlay/>
    </DataTemplate>

</ResourceDictionary>